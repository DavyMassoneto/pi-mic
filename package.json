{
  "name": "pi-mic",
  "version": "0.1.0",
  "description": "Voice input for pi (CLI and pi-web), transcribed through an OpenAI-compatible gateway (e.g. OmniRoute to Deepgram)",
  "type": "module",
  "keywords": [
    "pi-package",
    "voice",
    "speech-to-text",
    "deepgram"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavyMassoneto/pi-mic.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./src/cli/extension.ts"
    ]
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/testing",
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^22",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "lint": "biome check src scripts",
    "check:comments": "node scripts/check-no-comments.mjs",
    "check": "npm run lint && npm run check:comments && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
