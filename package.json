{
  "name": "pi-mic",
  "version": "0.1.0",
  "description": "Entrada por voz para o pi (CLI e pi-web), transcrita por um gateway OpenAI-compatível (ex.: OmniRoute → Deepgram)",
  "type": "module",
  "keywords": [
    "pi-package",
    "voice",
    "speech-to-text",
    "deepgram"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavyMassoneto/pi-mic.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "bin": {
    "pi-mic-web": "web/server.mjs"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "web",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^22",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src web scripts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
